<div class="section">
  <div class="page-width">
    <div class="newsletter">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- form 'customer', id: 'NewsletterForm' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p role="status"><strong>{{ 'general.newsletter_thanks' | t }}</strong></p>
        {%- else -%}
          <label for="NewsletterEmail" class="visually-hidden">{{ 'general.email' | t }}</label>
          <input id="NewsletterEmail" type="email" name="contact[email]" required placeholder="{{ 'general.email' | t }}" autocomplete="email">
          <button class="btn btn--yellow" type="submit">{{ section.settings.button }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "text", "id": "text", "label": "Text", "default": "Be first to hear about new products, seasonal drops and secret sales." },
    { "type": "text", "id": "button", "label": "Button", "default": "Sign me up" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
