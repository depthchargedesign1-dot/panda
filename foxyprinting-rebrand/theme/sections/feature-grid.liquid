<div class="section{% if section.settings.tinted %} section--tint{% endif %}">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    </div>
    <div class="feature-grid">
      {%- for block in section.blocks -%}
        <a class="feature {% render 'accent', name: block.settings.colour, index: forloop.index0 %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <div class="feature__media">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              <span aria-hidden="true">{{ block.settings.emoji }}</span>
            {%- endif -%}
          </div>
          <div class="feature__body">
            <span class="feature__tag">{{ block.settings.tag }}</span>
            <h3 class="feature__title">{{ block.settings.title }}</h3>
            <p class="feature__text">{{ block.settings.text }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature tiles",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New: we print on (almost) anything" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Fresh ranges from our new UV, UV DTF, DTF and cutting kit" },
    { "type": "checkbox", "id": "tinted", "label": "Tinted background", "default": true }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "emoji", "label": "Emoji fallback", "default": "✨" },
        { "type": "select", "id": "colour", "label": "Colour", "default": "auto", "options": [
          { "value": "auto", "label": "Automatic" }, { "value": "orange", "label": "Orange" }, { "value": "pink", "label": "Pink" }, { "value": "purple", "label": "Purple" }, { "value": "teal", "label": "Teal" }, { "value": "yellow", "label": "Yellow" } ] },
        { "type": "text", "id": "tag", "label": "Tag", "default": "New" },
        { "type": "text", "id": "title", "label": "Title", "default": "Acrylic photo blocks" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Feature tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
