{%- comment -%}
  Page: optional header banner from the page metafield foxy.header_image (same look as collection headers),
  then the page body.
{%- endcomment -%}
{%- assign header_image = page.metafields.foxy.header_image.value -%}
{%- if header_image -%}
  {%- liquid
    assign accents = 'orange,pink,purple,teal,yellow' | split: ','
    assign accent_i = page.id | modulo: 5
  -%}
  <div class="collection-hero collection-hero--banner accent-{{ accents[accent_i] }}">
    <div class="collection-hero__banner">
      {{ header_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,1800', sizes: '100vw', alt: '' }}
    </div>
    <div class="page-width collection-hero__inner">
      <div class="collection-hero__text">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> / <span aria-current="page">{{ page.title }}</span></nav>
        <h1>{{ page.title }}</h1>
      </div>
    </div>
  </div>
  <div class="section">
    <div class="page-width page-narrow">
      <div class="rte">{{ page.content }}</div>
    </div>
  </div>
{%- else -%}
  <div class="section">
    <div class="page-width page-narrow">
      <h1><span class="squiggle">{{ page.title }}</span></h1>
      <div class="rte" style="margin-top:28px">{{ page.content }}</div>
    </div>
  </div>
{%- endif -%}
{% schema %}
{ "name": "Page" }
{% endschema %}
