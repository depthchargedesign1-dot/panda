<div class="section{% if section.settings.tinted %} section--tint{% endif %}">
  <div class="page-width page-narrow" style="text-align: {{ section.settings.align }}">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}<p><a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Printed on anything, made with love" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }] },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "tinted", "label": "Tinted background", "default": false }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
