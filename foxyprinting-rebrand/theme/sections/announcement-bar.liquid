<div class="announcement" role="region" aria-label="{{ 'general.announcements' | t }}">
  <div class="announcement__inner" data-rotator data-interval="{{ section.settings.interval }}">
    {%- for block in section.blocks -%}
      {%- if block.settings.link != blank -%}
        <a class="announcement__item{% if forloop.first %} is-active{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
      {%- else -%}
        <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 8,
  "settings": [
    { "type": "range", "id": "interval", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "🚚 Free UK delivery on orders over £30" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "announcement" }] }]
}
{% endschema %}
