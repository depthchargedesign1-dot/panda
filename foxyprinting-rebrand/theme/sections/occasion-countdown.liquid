<div class="section section--tight">
  <div class="page-width">
    <div class="occasion {% render 'accent', name: section.settings.colour %}">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="badge badge--purple">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 style="margin-top:12px">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        {%- if section.settings.button_label != blank -%}<a class="btn btn--white" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
      <div class="countdown" data-countdown="{{ section.settings.date }}" aria-live="polite">
        <div class="countdown__unit"><span class="countdown__num" data-days>--</span><span class="countdown__lbl">{{ 'general.days' | t }}</span></div>
        <div class="countdown__unit"><span class="countdown__num" data-hours>--</span><span class="countdown__lbl">{{ 'general.hours' | t }}</span></div>
        <div class="countdown__unit"><span class="countdown__num" data-mins>--</span><span class="countdown__lbl">{{ 'general.mins' | t }}</span></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Occasion countdown",
  "settings": [
    { "type": "select", "id": "colour", "label": "Colour", "default": "pink", "options": [
      { "value": "orange", "label": "Orange" }, { "value": "pink", "label": "Pink" }, { "value": "purple", "label": "Purple" }, { "value": "teal", "label": "Teal" }, { "value": "yellow", "label": "Yellow" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🎄 Christmas 2026" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Order personalised Christmas gifts in time" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Last order date for guaranteed Christmas delivery is 18 December. Christmas Eve boxes, name baubles, matching jumpers and more." },
    { "type": "text", "id": "date", "label": "Countdown to (YYYY-MM-DD HH:MM)", "default": "2026-12-18 12:00" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Christmas" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Occasion countdown" }]
}
{% endschema %}
