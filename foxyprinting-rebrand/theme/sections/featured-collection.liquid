{%- liquid
  assign col = section.settings.collection
  assign tint = ''
  if section.settings.tinted
    assign tint = ' section--tint'
  endif
-%}
<div class="section{{ tint }}">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <h2><span class="squiggle">{{ section.settings.heading | default: col.title }}</span></h2>
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if col != blank -%}<a class="section-heading__link" href="{{ col.url }}">{{ 'general.view_all' | t }} →</a>{%- endif -%}
    </div>
    <ul class="product-grid">
      {%- if col != blank and col.products.size > 0 -%}
        {%- for product in col.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li><div class="product-card"><div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="product-card__body"><h3 class="product-card__title">{{ 'general.example_product' | t }}</h3><div class="product-card__price">£9.99</div></div></div></li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "checkbox", "id": "tinted", "label": "Tinted background", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
