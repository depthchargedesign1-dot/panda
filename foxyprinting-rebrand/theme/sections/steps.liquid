<div class="section">
  <div class="page-width">
    <div class="section-heading"><div><h2>{{ section.settings.heading }}</h2>{%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}</div></div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step {% render 'accent', index: forloop.index0 %}" {{ block.shopify_attributes }}>
          <span class="step__icon" aria-hidden="true">{{ block.settings.emoji }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How it works",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Personalised in three easy steps" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "See exactly what you'll get before you buy" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "emoji", "label": "Emoji", "default": "🎁" },
      { "type": "text", "id": "title", "label": "Title", "default": "Pick your gift" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Choose from thousands of designs and products." } ] }
  ],
  "presets": [{ "name": "How it works", "blocks": [
    { "type": "step", "settings": { "emoji": "🎁", "title": "Pick your gift", "text": "Choose from thousands of cards, mugs, clothing, keepsakes and more." } },
    { "type": "step", "settings": { "emoji": "✏️", "title": "Make it theirs", "text": "Type a name, add a message or upload a photo and watch the live preview update." } },
    { "type": "step", "settings": { "emoji": "🚚", "title": "We print & post", "text": "Printed in our UK workshop and dispatched fast — most orders leave within 1–2 working days." } }
  ] }]
}
{% endschema %}
