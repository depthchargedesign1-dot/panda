<div class="section">
  <div class="page-width">
    <h1>{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="feature-grid">
        {%- for article in blog.articles -%}
          <a class="feature {% render 'accent', index: forloop.index0 %}" href="{{ article.url }}">
            <div class="feature__media">{%- if article.image -%}{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}📰{%- endif -%}</div>
            <div class="feature__body"><span class="feature__tag">{{ article.published_at | date: '%d %b %Y' }}</span><h2 class="feature__title">{{ article.title }}</h2><p class="feature__text">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p></div>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</div>
{% schema %}
{ "name": "Blog" }
{% endschema %}
