<div class="section">
  <div class="page-width">
    <h1>{{ section.settings.heading }}</h1>
    <div class="cat-grid">
      {%- for collection in collections -%}
        {%- if collection.all_products_count > 0 -%}
          <a class="cat-card {% render 'accent', index: forloop.index0 %}" href="{{ collection.url }}">
            <div class="cat-card__media">
              {%- if collection.image -%}{{ collection.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}
              {%- elsif collection.products.first.featured_media -%}{{ collection.products.first.featured_media | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}<span style="font-size:2.6rem">🎁</span>{%- endif -%}
            </div>
            <div class="cat-card__body"><h2 class="cat-card__title h3">{{ collection.title }}</h2><span class="cat-card__meta">{{ 'collections.product_count' | t: count: collection.all_products_count }}</span></div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{ "name": "Collections list", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "All categories" } ] }
{% endschema %}
