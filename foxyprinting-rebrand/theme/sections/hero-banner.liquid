{%- comment -%}
  Vistaprint-style split hero: one large banner + two stacked side banners.
  First "Main banner" block is the big tile; "Side banner" blocks stack on the right.
{%- endcomment -%}
{%- liquid
  assign main = section.blocks | where: 'type', 'main' | first
  assign sides = section.blocks | where: 'type', 'side'
-%}
<div class="section section--tight">
  <div class="page-width hero-grid">
    {%- if main -%}
      <div class="hero-tile hero-tile--main {% render 'accent', name: main.settings.colour %}{% if main.settings.dark_text %} hero-tile--dark-text{% endif %}" {{ main.shopify_attributes }}>
        <div class="hero-tile__media">
          {%- if main.settings.image -%}
            {{ main.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800,1200,1600', sizes: '(min-width: 990px) 65vw, 100vw', alt: main.settings.image.alt }}
          {%- else -%}
            <span class="hero-tile__blob" style="width:520px;height:520px;right:-120px;top:-160px;background:var(--fx-pink)"></span>
            <span class="hero-tile__blob" style="width:260px;height:260px;right:180px;bottom:-120px;background:var(--fx-yellow)"></span>
            <span class="hero-tile__blob" style="width:120px;height:120px;right:60px;bottom:60px;background:var(--fx-purple)"></span>
          {%- endif -%}
        </div>
        <div class="hero-tile__content">
          {%- if main.settings.eyebrow != blank -%}<span class="hero-tile__eyebrow">{{ main.settings.eyebrow }}</span>{%- endif -%}
          <h1 class="hero-tile__title">{{ main.settings.heading }}</h1>
          {%- if main.settings.text != blank -%}<p class="hero-tile__text">{{ main.settings.text }}</p>{%- endif -%}
          <div class="hero-tile__cta-row">
            {%- if main.settings.button_label != blank -%}<a class="btn btn--white" href="{{ main.settings.button_link }}">{{ main.settings.button_label }}</a>{%- endif -%}
            {%- if main.settings.button2_label != blank -%}<a class="btn btn--ink" href="{{ main.settings.button2_link }}">{{ main.settings.button2_label }}</a>{%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
    {%- if sides.size > 0 -%}
      <div class="hero-side">
        {%- for block in sides limit: 2 -%}
          <a class="hero-tile hero-tile--side {% render 'accent', name: block.settings.colour %}{% if block.settings.dark_text %} hero-tile--dark-text{% endif %}" href="{{ block.settings.button_link }}" {{ block.shopify_attributes }}>
            <div class="hero-tile__media">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'eager', alt: block.settings.image.alt }}
              {%- else -%}
                <span class="hero-tile__blob" style="width:220px;height:220px;right:-60px;bottom:-80px;background:rgba(255,255,255,.25)"></span>
              {%- endif -%}
            </div>
            <div class="hero-tile__content">
              {%- if block.settings.eyebrow != blank -%}<span class="hero-tile__eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
              <h2 class="hero-tile__title">{{ block.settings.heading }}</h2>
              {%- if block.settings.text != blank -%}<p class="hero-tile__text">{{ block.settings.text }}</p>{%- endif -%}
              {%- if block.settings.button_label != blank -%}<span class="hero-tile__link">{{ block.settings.button_label }} →</span>{%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero banners",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "main",
      "name": "Main banner",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "select", "id": "colour", "label": "Colour", "default": "orange", "options": [
          { "value": "orange", "label": "Orange" }, { "value": "pink", "label": "Pink" }, { "value": "purple", "label": "Purple" }, { "value": "teal", "label": "Teal" }, { "value": "yellow", "label": "Yellow" } ] },
        { "type": "checkbox", "id": "dark_text", "label": "Dark text", "default": false },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New: we print on anything" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Personalised gifts they'll never forget" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Mugs, cards, baby grows, tumblers, slate, acrylic and more — add a name, photo or message and see it live before you buy." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Start personalising" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Shop Christmas" },
        { "type": "url", "id": "button2_link", "label": "Second button link" }
      ]
    },
    {
      "type": "side",
      "name": "Side banner",
      "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "select", "id": "colour", "label": "Colour", "default": "purple", "options": [
          { "value": "orange", "label": "Orange" }, { "value": "pink", "label": "Pink" }, { "value": "purple", "label": "Purple" }, { "value": "teal", "label": "Teal" }, { "value": "yellow", "label": "Yellow" } ] },
        { "type": "checkbox", "id": "dark_text", "label": "Dark text", "default": false },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Christmas Eve boxes" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Hero banners", "blocks": [{ "type": "main" }, { "type": "side" }, { "type": "side", "settings": { "colour": "teal", "heading": "Glass can cups" } }] }]
}
{% endschema %}
