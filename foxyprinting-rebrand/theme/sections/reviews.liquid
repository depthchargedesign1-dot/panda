<div class="section section--tint">
  <div class="page-width">
    <div class="section-heading">
      <div><h2>{{ section.settings.heading }}</h2>{%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}</div>
      {%- if section.settings.link != blank -%}<a class="section-heading__link" href="{{ section.settings.link }}">{{ section.settings.link_label }} →</a>{%- endif -%}
    </div>
    <div class="reviews">
      {%- for block in section.blocks -%}
        <figure class="review" {{ block.shopify_attributes }}>
          <div class="review__stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</div>
          {%- if block.settings.title != blank -%}<h3 class="review__title">{{ block.settings.title }}</h3>{%- endif -%}
          <blockquote class="review__text">“{{ block.settings.quote }}”</blockquote>
          <figcaption>
            <div class="review__name">{{ block.settings.name }}{% if block.settings.verified %} <span class="review__verified">✔ Verified buyer</span>{% endif %}</div>
            <div class="review__product">{{ block.settings.product }}</div>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reviews",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customers love Foxy" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read all reviews" },
    { "type": "url", "id": "link", "label": "Link (e.g. your Judge.me all-reviews page)" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "title", "label": "Review title" },
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "Add a real customer review here." },
      { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
      { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true },
      { "type": "text", "id": "product", "label": "Product", "default": "Personalised mug" } ] }
  ],
  "presets": [{ "name": "Reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
