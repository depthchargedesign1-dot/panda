<div class="section"><div class="page-width page-narrow">
  <h1>{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div class="form-field"><label for="FirstName">{{ 'customer.first_name' | t }}</label><input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name"></div>
    <div class="form-field"><label for="LastName">{{ 'customer.last_name' | t }}</label><input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name"></div>
    <div class="form-field"><label for="RegEmail">{{ 'general.email' | t }}</label><input type="email" name="customer[email]" id="RegEmail" autocomplete="email" required></div>
    <div class="form-field"><label for="RegPassword">{{ 'customer.password' | t }}</label><input type="password" name="customer[password]" id="RegPassword" autocomplete="new-password" required></div>
    <button class="btn" type="submit">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div></div>
