<div class="section"><div class="page-width page-narrow">
  <h1>{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="form-field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input type="password" name="customer[password]" id="ResetPassword" required></div>
    <div class="form-field"><label for="ResetConfirm">{{ 'customer.password_confirm' | t }}</label><input type="password" name="customer[password_confirmation]" id="ResetConfirm" required></div>
    <button class="btn" type="submit">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</div></div>
