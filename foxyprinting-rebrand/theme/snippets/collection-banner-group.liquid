{%- comment -%} Auto-generated from tools/collection_headers.py: picks a themed header banner (Files: foxy-header-<group>.png) from the collection handle. {%- endcomment -%}
{%- liquid
  assign h = collection.handle
  assign group = 'gifts'
  if h contains 'kids-cards'
    assign group = 'skip'
  elsif h contains 'skin' or h contains 'perfect-skins'
    assign group = 'skins'
  elsif h contains 'pet' or h contains 'dog'
    assign group = 'pets'
  elsif h contains 'baby' or h contains 'new-baby' or h contains 'teddy' or h contains 'christening'
    assign group = 'baby'
  elsif h contains 'christmas' or h contains 'santa' or h contains 'stocking' or h contains 'bauble' or h contains 'wrapping'
    assign group = 'christmas'
  elsif h contains 'halloween'
    assign group = 'halloween'
  elsif h contains 'easter'
    assign group = 'easter'
  elsif h contains 'valentine' or h contains 'wedding' or h contains 'engagement' or h contains 'future-husband' or h contains 'future-mrs' or h contains 'celebrity-lover' or h contains 'mothers' or h contains 'memorial'
    assign group = 'love'
  elsif h contains 'king-charles' or h contains 'jubilee' or h contains 've-day' or h contains 'flags' or h contains 'coronation-' and h != 'coronation-street-face-masks'
    assign group = 'commemorative'
  elsif h contains 'all-other-magnets' or h contains 'all-other-keyrings' or h contains 'atari' or h contains 'nintendo' or h contains 'sega' or h contains 'playstation' or h contains 'ps1' or h contains 'ps4' or h contains 'gameboy' or h contains 'snes' or h contains 'nes-' or h contains 'dreamcast' or h contains 'odyssey' or h contains 'coleco' or h contains 'colevision' or h contains 'neo-geo' or h contains 'amiga' or h contains 'intelivision' or h contains 'xbox' or h contains 'mega-cd' or h contains 'retro-gam' or h contains 'game-case' or h contains 'replacement' or h contains 'other-console' or h contains 'cd32' or h contains '3do' or h contains 'all-play'
    assign group = 'retro'
  elsif h contains 'signed' or h contains 'autograph' or h contains 'poster' or h contains 'personalised-prints' or h contains 'canvas' or h contains 'word-art' or h contains 'a6-'
    assign group = 'prints'
  elsif h contains 'walking-dead-star'
    assign group = 'prints'
  elsif h contains 'mask' or h contains 'celebrit' or h contains 'tv-star' or h contains 'comedians' or h contains 'politicians' or h contains 'towie' or h contains 'emmerdale' or h contains 'bollywood' or h contains 'request' or h contains 'love-island' or h contains 'money-heist' or h contains 'squid' or h contains 'saw' or h contains 'maid' or h contains 'bad-boys' or h contains 'ink-master' or h contains 'stranger' or h contains 'the-boys' or h contains 'the-victim' or h contains 'queen-of-flow' or h contains 'still-game' or h contains 'god-of-hellfire' or h contains 'gangs-of-london' or h contains 'austin' or h contains 'real-housewives' or h contains 'the-chase' or h contains 'britain-s-got' or h contains 'strictly' or h contains 'walking-dead' or h contains 'friends' or h contains 'neighbours' or h contains 'only-fools' or h contains 'sex-and' or h contains 'star-trek' or h contains 'madmens' or h contains 'hangover' or h contains 'hollyoaks' or h contains 'geordie' or h contains 'made-in-chelsea' or h contains 'coronation-street' or h contains 'eastenders' or h contains 'bake-off' or h contains 'big-bang' or h contains 'benidorm' or h contains 'eurovision' or h contains 'one-direction' or h contains 'xfactor' or h contains 'im-a-celebrity' or h contains 'marvel' or h contains 'copa' or h contains 'euro-2021' or h contains 'england-2021' or h contains 'wales-2021' or h contains 'face-cover'
    assign group = 'masks'
  elsif h contains 'business' or h contains 'loyalty' or h contains 'thank-you' or h contains 'signs-displays' or h contains 'craft-supplies' or h contains 'stationery'
    assign group = 'business'
  elsif h contains 'kids-labels' or h contains 'school' or h contains 'lunchbox' or h contains 'backpack' or h contains 'reward'
    assign group = 'kids'
  elsif h contains 'sticker' or h contains 'label' or h contains 'decal' or h contains 'phone-case' or h contains 'stickers-cases'
    assign group = 'stickers'
  elsif h contains 'gaming' or h contains 'gamer' or h contains 'game'
    assign group = 'gaming'
  elsif h contains 'coaster' or h contains 'bar-mat' or h contains 'man-cave'
    assign group = 'bar'
  elsif h contains 'glass' or h contains 'can-cup' or h contains 'bottle' or h contains 'flask' or h contains 'drinkware'
    assign group = 'drinkware'
  elsif h contains 'mug' or h contains 'i-like' or h contains 'i-love' or h contains 'id-rather' or h contains 'this-girl' or h contains 'this-guy' or h contains 'keep-calm' or h contains 'carry-on' or h contains 'scrabble' or h contains 'star-sign' or h contains 'dating' or h contains 'emoticon' or h contains 'alchemy' or h contains 'occupational' or h contains 'office-humour' or h contains 'coach' or h contains 'kings-are' or h contains 'manufacured' or h contains 'top-100' or h contains 'male-movie' or h contains 'female-movie' or h contains 'football-crazy' or h contains 'signs-for' or h contains 'league' or h contains 'national-league' or h contains 'scottish-football' or h contains 'premier-league' or h contains 'championship' or h contains 'international-football'
