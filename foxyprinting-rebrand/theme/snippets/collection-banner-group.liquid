    assign group = 'party'
  elsif h contains 'card' or h contains 'card-' or h contains 'birthday' or h contains 'occasion-birthday' or h contains 'fathers-day-cards'
    assign group = 'cards'
  elsif h contains 'kids' or h contains 'school' or h contains 'lunchbox' or h contains 'backpack' or h contains 'reward'
    assign group = 'kids'
  elsif h contains 'football' or h contains 'rugby' or h contains 'sport' or h contains 'golf' or h contains 'armband' or h contains 'towel' or h contains 'errea' or h contains 'euros' or h contains 'darts'
    assign group = 'sports'
  elsif h contains 't-shirt' or h contains 'tee' or h contains 'hoodie' or h contains 'clothing' or h contains 'apparel' or h contains 'scarves' or h contains 'bobble' or h contains 'workwear' or h contains 'pride' or h contains 'stag' or h contains 'hen-'
    assign group = 'clothing'
  elsif h contains 'sticker' or h contains 'label' or h contains 'decal' or h contains 'phone-case' or h contains 'stickers-cases'
    assign group = 'stickers'
  elsif h contains 'business' or h contains 'loyalty' or h contains 'thank-you' or h contains 'signs' or h contains 'craft-supplies' or h contains 'stationery'
    assign group = 'business'
  endif
  if group == 'skip'
