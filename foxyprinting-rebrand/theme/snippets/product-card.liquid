{%- comment -%}
  Product card.  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}
{%- liquid
  assign personalise_tag = settings.card_personalise_tag | default: 'personalised'
  assign trending_tag = settings.card_trending_tag | default: 'trending'
  assign is_personalised = false
  if product.tags contains personalise_tag or product.metafields.foxy.personalise_fields != blank
    assign is_personalised = true
  endif
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<div class="product-card">
  <div class="product-card__media">
    <div class="product-card__badges">
      {%- if on_sale -%}<span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>{%- endif -%}
      {%- if product.tags contains trending_tag -%}<span class="badge badge--pink">🔥 {{ 'products.product.trending' | t }}</span>{%- endif -%}
      {%- if is_personalised -%}<span class="badge">✏️ {{ settings.card_personalise_badge }}</span>{%- endif -%}
    </div>
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 25vw, 50vw', alt: product.featured_media.alt | default: product.title }}
      {%- if settings.card_show_secondary_image and product.media[1] -%}
        {{ product.media[1] | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="product-card__body">
    {%- if settings.card_show_vendor -%}<span class="product-card__vendor">{{ product.vendor }}</span>{%- endif -%}
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    <div class="product-card__price">{% render 'price', product: product, show_from: true %}</div>
    {%- if is_personalised -%}<span class="product-card__cta">{{ 'products.product.personalise_now' | t }} →</span>{%- endif -%}
  </div>
</div>
