{%- comment -%}
  Automatic "unofficial / not endorsed" notice for products that use someone
  else's name, likeness or trademark. Picks wording from the product type,
  title and tags. A product's own description disclaimer (p.disclaimer) or the
  metafield foxy.disclaimer always wins, so nothing is shown twice.
  Params: product
{%- endcomment -%}
{%- liquid
  assign custom = product.metafields.foxy.disclaimer.value
  assign tags_lc = product.tags | join: ',' | downcase
  assign type_lc = product.type | downcase
  # Whole-word matching: pad with spaces and turn punctuation into spaces, so "designed" never matches "signed".
  assign hay = product.type | append: ' ' | append: product.title | downcase | replace: '-', ' ' | replace: '–', ' ' | replace: ',', ' ' | replace: '.', ' ' | replace: '(', ' ' | replace: ')', ' ' | replace: '/', ' ' | replace: '|', ' ' | replace: ':', ' ' | replace: '&', ' ' | replace: "'", ''
  assign hay = ' ' | append: hay | append: ' '
  assign kind = 'none'

  # The customer's own photo or team: nobody else's name or likeness is used.
  assign own_design = false
  if hay contains ' your own ' or hay contains ' make your own ' or hay contains ' custom photo ' or hay contains ' personalised photo ' or hay contains ' your photo ' or hay contains ' your face ' or hay contains ' your team ' or hay contains ' your club ' or hay contains ' team colours '
    assign own_design = true
  endif

  assign tagged = false
  if tags_lc contains 'third-party-name'
    assign tagged = true
  endif
  assign new_range = false
  if tags_lc contains 'foxy-new-2026' and tagged == false
    assign new_range = true
  endif

  # Club and league names. Liquid has no and/or precedence, so build this up step by step.
  assign club = false
  if type_lc contains 'football' or tags_lc contains 'football mug' or tags_lc contains 'keep calm football' or tags_lc contains 'football crazy'
    assign club = true
  elsif hay contains ' premier league ' or hay contains ' fc ' or hay contains ' afc ' or hay contains ' united ' or hay contains ' rugby '
    assign club = true
  endif
  if own_design
    assign club = false
  endif

  if product.description contains 'class="disclaimer"'
    assign kind = 'none'
  elsif custom != blank
    assign kind = 'custom'
  elsif new_range
    # New 2026 products are written to the house rules: any disclaimer they need is in the description.
    assign kind = 'none'
  else
    if hay contains ' signed ' or hay contains ' autograph' or hay contains ' printed signature '
      assign kind = 'signed'
    elsif hay contains ' face mask' or hay contains ' facemask' or hay contains ' tv stars ' or hay contains ' celebrity '
      if own_design == false or hay contains ' celebrity '
        assign kind = 'person'
      endif
    elsif hay contains ' replacement case' or hay contains ' replacement game' or hay contains ' game case' or hay contains ' nintendo' or hay contains ' sega ' or hay contains ' playstation' or hay contains ' atari ' or hay contains ' xbox' or hay contains ' gameboy' or hay contains ' game boy' or hay contains ' snes ' or hay contains ' dreamcast' or hay contains ' retro gaming ' or hay contains ' megadrive' or hay contains ' mega drive'
      assign kind = 'game'
    elsif hay contains ' perfectdraft' or hay contains ' perfect draft' or hay contains ' perfect skin'
      assign kind = 'brand'
    elsif club
      # Club and league names (checked before "inspired", so "Oxford United INSPIRED" mugs get the club wording).
      assign kind = 'sport'
    elsif hay contains ' inspired ' or hay contains ' theme style ' or hay contains ' style theme ' or hay contains ' kidshows '
      assign kind = 'character'
    elsif tagged
      assign kind = 'generic'
    endif
    if kind == 'game' and hay contains ' case'
      assign game_case = true
    endif
  endif
-%}
{%- unless kind == 'none' -%}
  <div class="product-disclaimer">
    <strong>{{ 'products.disclaimer.heading' | t }}</strong>
    <p>
      {%- case kind -%}
        {%- when 'custom' -%}{{ custom }}
        {%- when 'signed' -%}{{ 'products.disclaimer.signed' | t }}
        {%- when 'person' -%}{{ 'products.disclaimer.person' | t }}
        {%- when 'game' -%}{{ 'products.disclaimer.game' | t }}{% if game_case %} {{ 'products.disclaimer.game_case' | t }}{% endif %}
        {%- when 'brand' -%}{{ 'products.disclaimer.brand' | t }}
        {%- when 'character' -%}{{ 'products.disclaimer.character' | t }}
        {%- when 'sport' -%}{{ 'products.disclaimer.sport' | t }}
        {%- else -%}{{ 'products.disclaimer.generic' | t }}
      {%- endcase -%}
    </p>
  </div>
{%- endunless -%}
