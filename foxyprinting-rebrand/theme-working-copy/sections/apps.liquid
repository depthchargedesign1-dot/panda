{%- comment -%} Holds app blocks (e.g. the Judge.me review widget) on any JSON template. {%- endcomment -%}
<div class="section{% if section.settings.tinted %} section--tint{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<div class="section-heading"><div><h2>{{ section.settings.heading }}</h2></div></div>{%- endif -%}
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "App blocks",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "tinted", "label": "Tinted background", "default": false }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "App blocks" }]
}
{% endschema %}
